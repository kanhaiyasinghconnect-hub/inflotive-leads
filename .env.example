# Copy this file to .env and fill in your values. Never share .env.

# Claude API key (https://console.anthropic.com) - powers the daily research
ANTHROPIC_API_KEY=

# Daily research size
LEADS_PER_DAY=12
SEGMENTS_PER_DAY=4

# Email sending (Gmail: turn on 2-step verification, then create an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DAILY_EMAIL_LIMIT=25
FOLLOW_UP_DAYS=4

# Automatic mode: email High/Medium leads whose address was confirmed on their website,
# then follow up on day 4 and day 9 in the same thread (stops when they reply).
AUTO_SEND=true
AUTO_SEND_PRIORITIES=High,Medium
SEQUENCE_DAYS=4,9

# Your signature
SENDER_NAME=INFLOTIVE
SENDER_TITLE=Business Development, INFLOTIVE
SENDER_PHONE=
SENDER_WEBSITE=
SENDER_ADDRESS=Noida, Uttar Pradesh, India

FLASK_SECRET_KEY=change-this-to-a-random-string
